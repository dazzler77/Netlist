<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">

  <name>SVG to SPICE Netlist</name>
  <id>com.yourname.svg_to_spice</id>

  <param name="show_wirelist" type="bool" gui-text="Display Wirelist on Canvas">false</param>
  <param name="show_netlist" type="bool" gui-text="Display SPICE Netlist on Canvas">false</param>
  
  <param name="text_x" type="float" gui-text="Text X Position">0</param>
  <param name="text_y" type="float" gui-text="Text Y Position">0</param>
  <param name="out" type="string" gui-text="Netlist Output File">netlist.cir</param>
  <param name="wire_out" type="string" gui-text="Wirelist Output File">wirelist.csv</param>

  <param name="layers" type="string" gui-text="Layers (comma-separated)">
  </param>

  <param name="tol" type="float" gui-text="Tolerance">0.5</param>

<param name="component_source"
       type="optiongroup"
       appearance="combo"
       gui-text="Component Source">
  <option value="id">ID</option>
  <option value="label">Label</option>
  <option value="title">Title</option>
  <option value="description">Description</option>
</param>

<param name="component_regex"
       type="string"
       gui-text="Component Regex">.*</param>

<param name="wire_source"
       type="optiongroup"
       appearance="combo"
       gui-text="Wire Source">
  <option value="id">ID</option>
  <option value="label">Label</option>
  <option value="title">Title</option>
  <option value="description">Description</option>
</param>

<param name="wire_regex"
       type="string"
       gui-text="Wire Regex">^wire</param>

<param name="pin_source"
       type="optiongroup"
       appearance="combo"
       gui-text="Pin Source">
  <option value="id">ID</option>
  <option value="label">Label</option>
  <option value="title">Title</option>
  <option value="description">Description</option>
</param>

<param name="pin_regex"
       type="string"
       gui-text="Pin Regex">^pin</param>
  <effect>
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Electrical"/>
    </effects-menu>
  </effect>

  <script>
    <command location="inx" interpreter="python">svg_to_spice.py</command>
  </script>

</inkscape-extension>
